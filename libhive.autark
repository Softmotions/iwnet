option { LIBHIVE_URL              LibHive HTTP/2 state machine external project source URL }

if { !defined { LIBHIVE_URL }
  set {
    LIBHIVE_URL
    https://github.com/Softmotions/libhive/archive/refs/heads/main.zip
  }
}

check {
  fetch_resource.sh { fetch-url{${LIBHIVE_URL}} C{extern_libhive} LIBHIVE_SRC_DIR }
}

set {
  LIBHIVE_LIB 
  ^{ C{${INSTALL_LIB_DIR}} /libhive.a }
}

set {
  LIBHIVE_HEADERS
  ^{ C{${INSTALL_INCLUDE_DIR}} /hive.h }
}

set {
  LIBHIVE_SOURCE_HEADER
  ^{ ${LIBHIVE_SRC_DIR} /include/hive.h }
}

run {
  shell { ^{PREFIX= C{}} ^{LIBDIR= C{${INSTALL_LIB_DIR}}} make -C ${LIBHIVE_SRC_DIR} 
    if { eq { ${BUILD_TYPE} Release }
      set { _ release install } 
    } else {
      set { _ dev install }
    }
  }
  consumes {
    ${LIBHIVE_SRC_DIR}
  }
  produces {
    ${LIBHIVE_LIB}
    ${LIBHIVE_HEADERS}
  }
}

install { ${INSTALL_LIB_DIR} ${LIBHIVE_LIB} }
# `hive.h` is a public include of libiwnet when the HTTP/2 or gRPC transport
# is enabled: the static archive links libhive and out-of-tree consumers (for
# example an HTTP/2 client session) include <hive.h>. It is installed from the
# libhive source tree, not from the build cache: in a nested build the cache
# belongs to iwnet while `--prefix` points at the parent project.
install { ${INSTALL_INCLUDE_DIR} ${LIBHIVE_SOURCE_HEADER} }
