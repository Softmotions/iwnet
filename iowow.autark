option { IOWOW_URL                IOWOW external project sources URL }

if { !defined { IOWOW_URL } 
  set {
    IOWOW_URL
    https://github.com/Softmotions/iowow/archive/refs/tags/v1.7.3.zip
  }
}

check {
  fetch_resource.sh { fetch-url{${IOWOW_URL}} C{extern_iowow} IOWOW_SRC_DIR }
  # Installed before the iwnet script is evaluated: libiowow.pc is required by
  # the pkg-config calls in iwnet's Autark.
  iowow_build.sh { C{} ${IOWOW_SRC_DIR} ${BUILD_TYPE} }
}

run {
  shell { ^{BUILD_TYPE= ${BUILD_TYPE}} autark --prefix C{} ${IOWOW_SRC_DIR} }
  consumes {
    ${IOWOW_SRC_DIR}
  }
  produces {
    C{include/iowow/iowow.h}
  }
}

run-on-install {
  shell { 
    autark --prefix ${INSTALL_PREFIX} 
    set { _ 
      if { ${IWNET_BUILD_SHARED_LIBS}
        -DIOWOW_BUILD_SHARED_LIBS=1
      }
    }
    ${IOWOW_SRC_DIR} 
  }
}

