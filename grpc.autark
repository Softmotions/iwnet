option { LIBHIVE_URL              LibHive HTTP/2 client state machine external project source URL }

if { !defined { LIBHIVE_URL }
  set {
    LIBHIVE_URL
    https://github.com/Softmotions/libhive/archive/refs/heads/main.zip
  }
}

check {
  fetch_resource.sh { fetch-url{${LIBHIVE_URL}} C{extern_libhive} LIBHIVE_SRC_DIR }
}

set {
  LIBHIVE_LIB 
  ^{ C{${INSTALL_LIB_DIR}} /libhive.a }
}

set {
  LIBHIVE_HEADERS
  ^{ C{${INSTALL_INCLUDE_DIR}} /hive.h }
}

run {
  shell { ^{PREFIX= C{}} ^{LIBDIR= C{${INSTALL_LIB_DIR}}} make -C ${LIBHIVE_SRC_DIR} 
    if { eq { ${BUILD_TYPE} Release }
      set { _ release install } 
    } else {
      set { _ dev install }
    }
  }
  consumes {
    ${LIBHIVE_SRC_DIR}
  }
  produces {
    ${LIBHIVE_LIB}
    ${LIBHIVE_HEADERS}
  }
}

set {
  parent {
    LDFLAGS
  }
  ..${LDFLAGS}
  ${LIBHIVE_LIB}
}

