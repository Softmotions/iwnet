cc {
  set { _
    grpc_test_client1.c
    grpc_test_client2.c
    grpc_test_client3.c
    grpc_test_client4.c
    grpc_test_client5.c
    grpc_test_client6.c
    grpc_test_client7.c
  }
  ${CFLAGS_TESTS}
}

foreach {
  OBJ
  ${CC_OBJS}
  run {
    exec { ${CC} ${OBJ} ${LDFLAGS_TEST} -o %{${OBJ}} }
    consumes { ${LIBIWNET_A} ${OBJ} }
    produces { %{${OBJ}} }
  }
}

if { ${IWNET_RUN_TESTS}
  set {
    TEST_RESOURCES
    grpc-server-cert.pem
    grpc-server-key.pem
    grpc_mock.py
    grpc_test_server1.py
    helloworld_pb2.py
    helloworld_pb2_grpc.py
    tests.sh
  }
  run {
    shell {
      cp
      SS{${TEST_RESOURCES}}
      CC{}
    }
    consumes {
      SS{${TEST_RESOURCES}}
    }
  }

  run {
    always
    shell { ./tests.sh }
    shell { ./tests.sh --ssl }
  }
}
