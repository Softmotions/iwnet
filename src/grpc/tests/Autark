cc {
  set { _
    grpc_test_client1.c
    grpc_test_client2.c
    grpc_test_client3.c
  }
  ${CFLAGS_TESTS}
}

foreach {
  OBJ
  ${CC_OBJS}
  run {
    exec { ${CC} ${OBJ} ${LDFLAGS_TEST} -o %{${OBJ}} }
    consumes { ${LIBIWNET_A} ${OBJ} }
    produces { %{${OBJ}} }
  }
}

if { ${IWNET_RUN_TESTS}
  run {
    shell { cp SS{grpc_test_server1.py helloworld_pb2.py helloworld_pb2_grpc.py tests.sh} CC{} }
  }

  run {
    always
    shell { ./tests.sh }
  }
}
